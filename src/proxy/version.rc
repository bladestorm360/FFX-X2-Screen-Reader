#include <windows.h>
#include "../native/build_version.hpp"

1 VERSIONINFO
 FILEVERSION FFX_FILE_VERSION
 PRODUCTVERSION FFX_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "bladestorm360\0"
            VALUE "FileDescription", "Final Fantasy X HD Screen Reader\0"
            VALUE "FileVersion", FFX_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "FFXScreenReader\0"
            VALUE "OriginalFilename", "dinput8.dll\0"
            VALUE "ProductName", "FFX / FFX-2 Screen Reader\0"
            VALUE "ProductVersion", FFX_FILE_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
