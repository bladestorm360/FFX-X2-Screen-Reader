# Release output — never commit packaged zips or staging folders
releases/

# Dev scripts — Ghidra/Frida probes and their output are local-only.
# The shipping mod's JS source lives at src/**/*.js and IS committed;
# the bundled artifact at install/ffx_sr.js is NOT (regenerated by the build).
Docs/Scripts/

# frida-compile build output + devDependencies
install/
src/build/node_modules/
src/build/package-lock.json
src/package-lock.json

# Runtime logs
FFX_SR_Latest.log
*.log

# C/C++ build artifacts
*.obj
*.exp
*.lib
*.ilk
*.pdb

# .NET build artifacts (archived C# mod output, just in case)
bin/
obj/

# Visual Studio / IDE
.vs/
.vscode/
*.user
*.suo
CMakeCache.txt
CMakeFiles/
cmake-build-*/

# OS
Thumbs.db
.DS_Store

# Archived / abandoned experiments — development reference only, not shipped
archived/

# Frida gadget — upstream dependency, not our code. See lib/README.md for how to obtain.
lib/frida-gadget.dll
